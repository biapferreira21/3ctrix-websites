{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "3ctrix-websites",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "3ctrix-websites"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "3ctrix.com",
      "zone_name": "3ctrix.com"
    },
    {
      "pattern": "3ctrix.com/*",
      "zone_name": "3ctrix.com"
    }
  ]
}
