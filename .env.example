# ============================================================
# 3C Trix Studio — variáveis de ambiente (exemplo)
# ------------------------------------------------------------
# Copie este ficheiro para ".env.local" e preencha os valores.
# NUNCA coloque chaves ou segredos no código do frontend.
# O ficheiro .env.local NÃO deve ser enviado para o repositório.
# ============================================================

# --- Número de WhatsApp (formato internacional, apenas dígitos) ---
# Exemplo para Portugal: 351912345678
# Enquanto estiver vazio, o botão de WhatsApp fica desativado.
NEXT_PUBLIC_WHATSAPP_NUMBER=351935477498

# --- Email público de contacto (mostrado no site) ---
# Exemplo: ola@3ctrixstudio.pt
NEXT_PUBLIC_CONTACT_EMAIL=websites@3ctrix.com

# --- URL base do site (usado para SEO / sitemap / Open Graph) ---
# Exemplo: https://www.3ctrixstudio.pt
NEXT_PUBLIC_SITE_URL=https://3ctrix.com/websites

# ============================================================
# Envio do formulário de contacto através do Resend
# A chave é usada apenas no servidor e nunca fica exposta no browser.
# ============================================================

# RESEND_API_KEY=
CONTACT_TO_EMAIL=websites@3ctrix.com
CONTACT_FROM_EMAIL=3C Trix Studio <websites@3ctrix.com>
