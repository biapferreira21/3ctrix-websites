{
  "name": "3c-trix-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page da 3C Trix Studio — criação e redesign de websites para pequenos negócios.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
